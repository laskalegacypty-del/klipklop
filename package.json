{
  "name": "klipklop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "bash -lc 'set -a && . ./.env.cf-build && set +a && vite build'",
    "lint": "eslint .",
    "preview": "vite preview",
    "rules:ingest": "node scripts/ingest-rules.mjs",
    "dev:api": "node scripts/local-api-server.mjs",
    "dev:layer2": "node scripts/run-layer2.mjs",
    "test:layer2": "node scripts/test-layer2.mjs",
    "d1:export": "node scripts/export-supabase-to-d1.mjs",
    "dev:worker-api": "wrangler dev -c workers/api/wrangler.toml --port 3001",
    "deploy:api": "wrangler deploy -c workers/api/wrangler.toml",
    "deploy": "npm run build && wrangler deploy",
    "deploy:cf": "npm run deploy:api && npm run deploy",
    "secret:service-role": "node scripts/put-service-role.mjs",
    "go-live": "node scripts/go-live-cloudflare.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.2",
    "@tailwindcss/forms": "^0.5.11",
    "autoprefixer": "^10.4.27",
    "lucide-react": "^0.577.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.5.207",
    "postcss": "^8.5.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-easy-crop": "^5.5.7",
    "react-hot-toast": "^2.6.0",
    "react-joyride": "^3.0.2",
    "react-router-dom": "^7.13.1",
    "rules-engine": "github:Geck018/rules-engine",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.0",
    "wrangler": "^4.28.0"
  }
